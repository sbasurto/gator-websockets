[Unit]
Description=Gator WebSocket cleanup, metrics and alerts
After=postgresql.service

[Service]
Type=oneshot
User=tomcat
Group=tomcat
Environment=WS_DB_NAME=db_wmssoft
ExecStart=/usr/local/sbin/gator-websockets-maintenance
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
