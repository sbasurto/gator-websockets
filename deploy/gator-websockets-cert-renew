#!/usr/bin/env bash
set -euo pipefail

lineage=${RENEWED_LINEAGE:?RENEWED_LINEAGE is required}
domain=${lineage##*/}
target=/etc/haproxy/certs/$domain.pem
temporary=$(mktemp)
trap 'rm -f "$temporary"' EXIT

cat "$lineage/fullchain.pem" "$lineage/privkey.pem" > "$temporary"
install -o root -g root -m 600 "$temporary" "$target"
haproxy -c -f /etc/haproxy/haproxy.cfg
systemctl reload haproxy.service
